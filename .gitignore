# Rust 빌드 결과물 (leading slash 없이 — kernel/target 등 하위 디렉토리도 포함)
target/
**/*.rs.bk

# make로 재생성되는 빌드 산출물 (ISO, ext4 이미지, musl 런타임 등)
/build/

# limine 부트로더 — `make limine-fetch`가 upstream에서 받아온다.
# 예전에 중첩 git 저장소(gitlink)로 잘못 커밋돼 clone 시 빈 디렉토리만
# 생기는 문제가 있었다. 추적 대상에서 제외하고 항상 받아쓰도록 한다.
/limine/

# 컴파일된 라이브러리 및 실행 파일
*.o
*.a
*.so
*.elf
*.bin
*.iso
*.img

# IDE 설정 (VS Code 등)
.vscode/
.idea/

# 시스템 파일
.DS_Store
Thumbs.db

# 로그 및 덤프 파일
*.log
*.dump

# 커널 이미지나 디스크 이미지 (용량이 크다면 제외)
# *.disk
# *.kernel

# 대회 관련 문서 — 저장소에 포함하지 않는다.
# 주최측이 배포한 발표자료/안내문은 타인의 저작물이라 공개 재배포가 부적절하고,
# 제출 서류(결과보고서 등)는 프로젝트 소스와 무관하다.
/2026 오픈소스 개발자대회*
/01. *
/02. *
/03. *
/04. *
*.hwp
*.hwpx
*.docx
