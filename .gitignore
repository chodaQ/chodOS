# Rust 빌드 결과물 (leading slash 없이 — kernel/target 등 하위 디렉토리도 포함)
target/
**/*.rs.bk

# make로 재생성되는 빌드 산출물 (ISO, ext4 이미지, musl 런타임 등)
/build/

# 컴파일된 라이브러리 및 실행 파일
*.o
*.a
*.so
*.elf
*.bin
*.iso
*.img

# IDE 설정 (VS Code 등)
.vscode/
.idea/

# 시스템 파일
.DS_Store
Thumbs.db

# 로그 및 덤프 파일
*.log
*.dump

# 커널 이미지나 디스크 이미지 (용량이 크다면 제외)
# *.disk
# *.kernel
